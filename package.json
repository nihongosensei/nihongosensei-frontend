{
  "name": "nihongosensei-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && cp src/instrumentation.ts dist/",
    "preview": "node --experimental-loader=@opentelemetry/instrumentation/hook.mjs --experimental-strip-types --env-file .env.local --import ./dist/instrumentation.ts ./dist/server/entry.mjs",
    "astro": "astro",
    "test": "vitest",
    "pre-commit": "pretty-quick --staged"
  },
  "dependencies": {
    "@astrojs/node": "^10.0.4",
    "@astrojs/react": "^5.0.2",
    "@heroicons/react": "^2.2.0",
    "@nanostores/react": "^1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-undici": "0.24.0",
    "@opentelemetry/sdk-node": "0.214.0",
    "astro": "^6.1.3",
    "clsx": "^2.1.1",
    "nanostores": "^1.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "use-debounce": "^10.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "pretty-quick": "^4.2.2",
    "tailwindcss": "^4.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.2"
  }
}
