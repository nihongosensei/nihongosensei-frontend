{
  "name": "nihongosensei-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && cp src/instrumentation.ts dist/",
    "preview": "node --experimental-loader=@opentelemetry/instrumentation/hook.mjs --experimental-strip-types --env-file .env.local --import ./dist/instrumentation.ts ./dist/server/entry.mjs",
    "astro": "astro",
    "test": "vitest",
    "pre-commit": "pretty-quick --staged"
  },
  "dependencies": {
    "@astrojs/node": "^10.1.4",
    "@astrojs/preact": "^5.1.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-undici": "0.24.0",
    "@opentelemetry/sdk-node": "0.214.0",
    "astro": "^6.4.6",
    "clsx": "^2.1.1",
    "preact": "^10.29.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "pretty-quick": "^4.2.2",
    "tailwindcss": "^4.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
