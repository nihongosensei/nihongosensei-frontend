---
import "../styles/global.css";
import { SITE_NAME, SEO_DESCRIPTION } from "~services/constants";

interface Props {
  title?: string;
}

const { title = SITE_NAME } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="description" content={SEO_DESCRIPTION} />
    <title>{title} - nihongosensei.app</title>
  </head>
  <body
    class="bg-white text-black dark:bg-neutral-900 dark:text-white font-sans"
  >
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
