---
interface Props {
  autoFocus?: boolean;
  value?: string;
  class?: string;
}

const { autoFocus = false, value, class: className } = Astro.props;
---

<form action="/search" method="get" class={className}>
  <input
    name="q"
    type="text"
    value={value}
    placeholder="Einträge suchen..."
    class="w-full px-3 py-2 bg-transparent text-black dark:text-white border border-neutral-300 dark:border-neutral-700 rounded-sm outline-hidden focus:border-neutral-500"
    autofocus={autoFocus}
  />
</form>
