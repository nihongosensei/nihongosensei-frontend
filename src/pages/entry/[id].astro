---
import Layout from "../../layouts/Layout.astro";
import ContentWrapper from "../../components/Dict/ContentWrapper/ContentWrapper.astro";
import { EntryFull } from "~components/Dict/Entry/EntryFull";
import { Synonyms } from "~components/Dict/Entry/Synonyms";
import { RelatedEntries } from "~components/Dict/Entry/RelatedEntries";
import { JlptBadge } from "~components/Dict/Entry/JlptBadge";
import { EntryKanjis } from "~components/Dict/EntryKanjis/EntryKanjis";
import { Alert } from "~components/ui/Alert";
import { parseError } from "~helper";
import { vocabularyService } from "../../services/VocabularyService/instance";

const { id } = Astro.params;

let entry = null;
let error: string | null = null;

try {
  entry = await vocabularyService().findById(String(id));
} catch (e) {
  console.error(e);
  error = parseError(e);
  Astro.response.status = 502;
}

if (!error && !entry) {
  return Astro.rewrite("/404");
}
---

<Layout title={entry?.entry.entryJson.form.orth[0]?.value}>
  <ContentWrapper>
    {
      error || !entry ? (
        <Alert type="error">
          <p>Ein Fehler ist aufgetreten:</p>
          <code>{error}</code>
        </Alert>
      ) : (
        <Fragment>
          <EntryFull entry={entry.entry.entryJson} />
          {entry.entry.jlpt && (
            <div class="my-2">
              <JlptBadge level={entry.entry.jlpt} />
            </div>
          )}
          <Synonyms
            className="pt-4 mt-4 border-t border-neutral-300 dark:border-neutral-700"
            entries={entry.synonyms?.map((s) => s.entryJson) ?? []}
          />
          <EntryKanjis
            className="mt-4 pt-4 border-t border-neutral-300 dark:border-neutral-700"
            kanjis={entry.kanjis ?? []}
          />
          <RelatedEntries
            className="pt-4 mt-4 border-t border-neutral-300 dark:border-neutral-700"
            entries={entry.relatedEntries ?? []}
          />
        </Fragment>
      )
    }
  </ContentWrapper>
</Layout>
