---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/layout/Logo.astro";
import Footer from "../components/layout/Footer.astro";
import Search from "../components/layout/Search.astro";
import { Link } from "~components/ui/Link";

export const prerender = true;
---

<Layout>
  <div class="h-screen flex flex-col mx-auto text-center p-3 max-w-[400px]">
    <div class="w-full flex flex-col grow justify-center items-center">
      <Logo class="mb-8" size="big" />
      <Search class="w-full mb-8" autoFocus={true} />
      <p>
        Weitere Links: <Link href="/furigana">Furigana Generator</Link>
      </p>
    </div>
    <Footer />
  </div>
</Layout>
