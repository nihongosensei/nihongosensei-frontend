---
import Layout from "../layouts/Layout.astro";
import ContentWrapper from "../components/Dict/ContentWrapper/ContentWrapper.astro";
import { EntriesContainer } from "~components/Dict/Entries/EntriesContainer";
import { vocabularyService } from "../services/VocabularyService/instance";
import { parseError } from "../helper";
import { DEFAULT_LIMIT } from "../services/constants";

const query = Astro.url.searchParams.get("q");
const pageString = Astro.url.searchParams.get("page");
let page = 1;
if (pageString != null) {
  const pageNumber = parseInt(pageString, 10);
  if (!isNaN(pageNumber)) {
    page = pageNumber;
  }
}
const limit = DEFAULT_LIMIT;
const offset = (page - 1) * limit;

let results = null;
let count = null;
let error = null;
let pageCount = 0;

try {
  const response = await vocabularyService().findBy({
    limit,
    offset,
    query,
  });
  pageCount = Math.ceil(response.count / limit);
  results = response.entries;
  count = response.count;
} catch (e) {
  console.log(e);
  error = parseError(e);
}
---

<Layout title={`Suche nach ${query}`}>
  <ContentWrapper>
    <EntriesContainer
      pageCount={pageCount}
      currentPage={page}
      results={results}
      query={query}
      count={count}
      error={error}
    />
  </ContentWrapper>
</Layout>
