---
import Layout from "../layouts/Layout.astro";
import ContentWrapper from "../components/Dict/ContentWrapper/ContentWrapper.astro";
import { EntriesContainer } from "~components/Dict/Entries/EntriesContainer";
import { vocabularyService } from "../services/VocabularyService/instance";
import { parseError, parsePage } from "../helper";
import { Alert } from "~components/ui/Alert";
import { DEFAULT_LIMIT } from "../services/constants";

const query = (Astro.url.searchParams.get("q") ?? "").trim();
const page = parsePage(Astro.url.searchParams.get("page"));
const limit = DEFAULT_LIMIT;
const offset = (page - 1) * limit;

let results = null;
let count = null;
let error = null;
let pageCount = 0;

if (query) {
  try {
    const response = await vocabularyService().findBy({
      limit,
      offset,
      query,
    });
    pageCount = Math.ceil(response.count / limit);
    results = response.entries;
    count = response.count;
  } catch (e) {
    console.error(e);
    error = parseError(e);
  }
}
---

<Layout title={`Suche nach ${query}`}>
  <ContentWrapper>
    {!query && <Alert type="info">Bitte einen Suchbegriff eingeben.</Alert>}
    <EntriesContainer
      pageCount={pageCount}
      currentPage={page}
      results={results}
      query={query}
      count={count}
      error={error}
    />
  </ContentWrapper>
</Layout>
