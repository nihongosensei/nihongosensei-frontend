---
import { DEFAULT_FURIGANA_INPUT_VALUE } from "astro:env/server";
import Layout from "../layouts/Layout.astro";
import { Link } from "~components/ui/Link";
import Logo from "../components/layout/Logo.astro";
import Grid from "../components/layout/Grid.astro";
import { FuriganaGenerator } from "../components/FuriganaGenerator/FuriganaGenerator";
import { furiganaService } from "../services/FuriganaService/instance";

const furigana = await furiganaService().getFurigana(
  DEFAULT_FURIGANA_INPUT_VALUE,
);
---

<Layout title="Furigana Generator">
  <Grid>
    <Link href="/" color="plain" className="header">
      <Logo text="Furigana Generator" />
    </Link>
    <FuriganaGenerator
      client:load
      text={DEFAULT_FURIGANA_INPUT_VALUE}
      furigana={furigana}
      error={null}
    />
  </Grid>
</Layout>

<style>
  .header {
    grid-area: header;
  }
</style>
